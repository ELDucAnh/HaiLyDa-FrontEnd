{
  "name": "invenza",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npx tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --minify",
    "watch": "npx tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --watch",
    "dev": "npx concurrently \"npx tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --watch\" \"npx lite-server\"",
    "dev:react": "vite",
    "build:react": "tsc --noEmit && vite build",
    "preview:react": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.0.0",
    "lite-server": "^2.6.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  }
}
